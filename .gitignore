# Abhängigkeiten
node_modules/
.pnp/
.pnp.js

# Builds
frontend/dist/
frontend/public/textures/     # werden beim Build erzeugt
frontend/public/geo/          # dito: Beschriftung
frontend/.geo-cache/          # Zwischenstand fuer das Zeichnen der Vektorkarte

# Umgebungsvariablen und Keys – NIE committen
.env
.env.*
!.env.example
hostpoint/snapshot.config.php

# Schluessel fuer den Tresor. Nur die Vorlage gehoert ins Repo.
# Am 22.08. hat GitGuardian einen service_role-Schluessel in 0002_cron.sql
# gemeldet – er stand im Klartext in einer versionierten Migration.
supabase/secrets/*.sql
!supabase/secrets/*.example.sql

# Snapshots, die zur Laufzeit entstehen
hostpoint/data/
frontend/public/data/*.json
!frontend/public/data/latest.demo.json

# Supabase CLI
supabase/.branches/
supabase/.temp/
.supabase/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Vollständiges Nohemi-Paket (liegt lokal im Projektordner).
# Im Repo sind nur die vier tatsächlich genutzten woff2 unter frontend/src/fonts.
/Nohemi/

# Stichproben der Rohdaten (gross, nur zum Entwickeln)
_sample/

# Zwischenspeicher der Register-Skripte: Antworten von Media Cloud und
# Wikidata, mehrere hundert MB. Jederzeit neu holbar, gehoert nicht ins Repo.
.cache/

# Altlasten aus frueheren Umbauten – darf komplett weg
_to_delete/

# Fertiges Hostpoint-Paket, wird bei Bedarf neu gebaut
upload/

# Reste des Netzlaufwerks: Wird eine Datei ueberschrieben, waehrend etwas sie
# offen haelt, legt FUSE die alte Fassung unter diesem Namen ab. Das waren am
# 22.08. drei Kopien alter .env.local mit Schluesseln darin – und .env.* greift
# bei diesem Namen nicht.
.fuse_hidden*
