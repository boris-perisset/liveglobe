# Globe News – Apache-Konfiguration für Hostpoint
# Diese Datei wird zusammen mit dem Frontend-Build ins Web-Root deployt.

# ------------------------------------------------------------------ HTTPS erzwingen
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Vorkomprimierte Snapshots ausliefern, wenn der Browser gzip kann.
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{DOCUMENT_ROOT}/$1.gz -f
  RewriteRule ^(data/.+\.json)$ /$1.gz [L]

  # SPA-Fallback: alles, was keine Datei ist, geht an index.html.
  # Ausser unter /assets/ – dort wäre eine fehlende Datei ein echter Fehler, und
  # als index.html getarnt sähe man statt eines 404 nur rätselhaftes Verhalten.
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<FilesMatch "\.json\.gz$">
  Header set Content-Encoding gzip
  Header set Content-Type "application/json; charset=utf-8"
</FilesMatch>

# ------------------------------------------------------------------ MIME-Typen
# MapLibre lädt seinen Web Worker als .mjs nach. Liefert Apache die Datei als
# application/octet-stream aus, verweigert der Browser die Ausführung und die
# Karte bleibt leer – ohne erkennbare Fehlermeldung.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

# ------------------------------------------------------------------ Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------ Caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite-Assets tragen einen Hash im Namen – dürfen lange liegen bleiben.
  <FilesMatch "\.(js|css|jpg|png|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  # Snapshots werden alle 5 Minuten neu geschrieben.
  <FilesMatch "^latest\.json(\.gz)?$">
    ExpiresDefault "access plus 2 minutes"
    Header set Cache-Control "public, max-age=120"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------ Sicherheit
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Konfiguration und Cron-Skript nicht über den Browser erreichbar machen.
# Bewusst ohne Endung am Ende: Editoren legen Sicherungen wie
# snapshot.config.php.save an, und die würde Apache sonst als reinen Text
# ausliefern – mitsamt Schlüssel.
<FilesMatch "^(snapshot\.php|snapshot\.config.*)$">
  Require all denied
</FilesMatch>

# Dasselbe für die verbreiteten Sicherungsmuster von Editoren.
<FilesMatch "(~|\.save(\.\d+)?|\.bak|\.orig|\.swp)$">
  Require all denied
</FilesMatch>

Options -Indexes
