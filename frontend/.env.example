# Kopieren nach .env.local und ausfüllen.
# Der anon-Key ist öffentlich (RLS schützt die Daten) – der service_role-Key gehört
# NIEMALS ins Frontend.

VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Statischer Snapshot auf dem eigenen Server. Relativ zum Web-Root.
VITE_SNAPSHOT_URL=./data/latest.json

# Basiskarte. Standard ist der dunkle Stil von OpenFreeMap;
# jede andere MapLibre-Stildatei tut es auch.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/dark
